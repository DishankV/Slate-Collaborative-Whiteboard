# Used by docker-compose.yml. Copy to .env and fill in real values -
# never commit the real .env file.

MONGO_ROOT_USER=whiteboard_admin
MONGO_ROOT_PASSWORD=SlatePassword1234

# Origin(s) allowed to call the backend (comma-separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:8080

# Baked into the frontend build - where the browser should reach the backend
VITE_SERVER_URL=http://localhost:4000
